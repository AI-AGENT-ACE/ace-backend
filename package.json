{
  "name": "ace-backend",
  "version": "0.1.0",
  "private": true,
  "description": "ACE Cloud Backend",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "prestart:dev": "prisma generate",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "setup:dev": "node scripts/setup-dev.mjs",
    "db:local": "node scripts/local-postgres.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "trash:purge": "node dist/scripts/purge-trash.js",
    "format": "prettier --write src test scripts prisma/schema.prisma prisma.config.ts README.md docs",
    "format:check": "prettier --check src test scripts prisma.config.ts README.md docs",
    "lint": "eslint src test",
    "test": "jest --runInBand",
    "test:cov": "jest --coverage --runInBand",
    "test:e2e": "node scripts/run-e2e.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.0",
    "prisma": "^7.0.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "overrides": {
    "multer": "^2.4.0",
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testMatch": ["<rootDir>/src/**/*.spec.ts"],
    "transform": { "^.+\\.ts$": ["ts-jest", { "tsconfig": "tsconfig.json" }] },
    "collectCoverageFrom": ["src/**/*.ts", "!src/generated/**", "!src/**/*.module.ts", "!src/**/*.dto.ts", "!src/main.ts"],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  }
}
