generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL
  SYSTEM
}

enum PermissionPolicy {
  ALWAYS_ALLOW
  ASK
  ALWAYS_ASK
}

enum ToolExecutionStatus {
  SUCCEEDED
  FAILED
  DENIED
}

enum VoiceCommandStatus {
  SUCCESS
  FAILED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions          AuthSession[]
  conversations     Conversation[]
  agentSettings     AgentSettings?
  permissions       Permission[]
  toolExecutionLogs ToolExecutionLog[]
  voiceCommandExecutionLogs VoiceCommandExecutionLog[]
}

model AuthSession {
  id           String    @id @default(cuid())
  userId       String
  refreshHash  String
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String    @default("새 대화")
  isPinned  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId, deletedAt, updatedAt, id])
  @@index([deletedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id])
}

model AgentSettings {
  id               String   @id @default(cuid())
  userId           String   @unique
  responseLanguage String   @default("ko")
  ttsEnabled       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Permission {
  id        String           @id @default(cuid())
  userId    String
  toolName  String
  policy    PermissionPolicy
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, toolName])
  @@index([userId])
}

model ToolExecutionLog {
  id        String              @id @default(cuid())
  userId    String?
  toolName  String
  status    ToolExecutionStatus
  errorCode String?
  duration  Int?
  createdAt DateTime            @default(now())
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt, id])
  @@index([toolName, createdAt])
}

model VoiceCommandExecutionLog {
  id          String             @id @default(cuid())
  userId      String?
  commandType String
  status      VoiceCommandStatus
  duration    Int
  errorCode   String?
  createdAt   DateTime           @default(now())
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt, id])
  @@index([commandType, createdAt])
}
