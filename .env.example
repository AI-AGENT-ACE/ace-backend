NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://ace:REPLACE_ME@127.0.0.1:55432/ace?schema=public
TEST_DATABASE_URL=postgresql://ace:REPLACE_ME@127.0.0.1:55432/ace_test?schema=public
JWT_ACCESS_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost
SWAGGER_ENABLED=true
AI_SERVER_URL=
AI_SERVER_API_KEY=
WEATHER_API_KEY=
EXTERNAL_API_TIMEOUT_MS=10000
REQUEST_BODY_LIMIT=128kb
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=26214400
MAX_FILES_PER_MESSAGE=5
TRASH_RETENTION_DAYS=30
TRASH_CLEANUP_CRON=0 3 * * *
TRASH_CLEANUP_TIME_ZONE=Asia/Seoul
TRASH_CLEANUP_BATCH_SIZE=250
TRASH_CLEANUP_ENABLED=true
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=120
TRUST_PROXY_HOPS=0

# compose.production.yaml infrastructure variables (server only)
POSTGRES_USER=ace
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD
POSTGRES_DB=ace
BACKEND_PORT=3001
